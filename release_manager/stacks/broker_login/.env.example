# Reference only. The real file lives at
#   /srv/dev_stack/CENTRALISED_BROKER_LOGIN/broker_login/.env
# and is placed by hand. No release script reads, writes or removes it.
# Set it to mode 600. Never prefix a value with quotes.

# ── storage ─────────────────────────────────────────────────────────────────
POSTGRES_DB=broker_login
POSTGRES_USER=broker_login
POSTGRES_PASSWORD=
# 32 random bytes as 64 hex characters (openssl rand -hex 32). Encrypts tokens
# at rest. Back it up apart from the database: without it the dumps are useless.
CBL_ENCRYPTION_KEY=

# ── accounts ────────────────────────────────────────────────────────────────
# Comma-separated aliases, logged in one after another in this order. Each alias
# needs its own DHAN_<ALIAS>_* block below, in upper case.
CBL_ACCOUNTS=main

# The public callback registered with every Dhan API app.
DHAN_REDIRECT_URL=https://login.beonedge.in/dhan/callback

DHAN_MAIN_CLIENT_ID=
DHAN_MAIN_API_KEY=
DHAN_MAIN_API_SECRET=
DHAN_MAIN_ACCOUNT_ID=
DHAN_MAIN_ACCOUNT_PIN=
# The base32 seed of the account's Dhan authenticator. Used only to log in.
DHAN_MAIN_TOTP_SECRET=

# ── token API ───────────────────────────────────────────────────────────────
# The seed consumers use to prove themselves for this account. A DIFFERENT seed
# from DHAN_MAIN_TOTP_SECRET: a code that fetches a token must never be able to
# log in to the broker.
TOKEN_API_MAIN_TOTP_SECRET=

# ── telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
