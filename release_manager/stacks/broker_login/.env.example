# Reference only. The real file lives at
#   /srv/dev_stack/CENTRALISED_BROKER_LOGIN/broker_login/.env
# and is placed by hand with mode 600. No release script reads, writes or
# removes it. Values are unquoted. Every key here is also in config/env.example;
# the export refuses to ship if the two disagree.

# ── storage ─────────────────────────────────────────────────────────────────
POSTGRES_DB=broker_login
POSTGRES_USER=broker_login
POSTGRES_PASSWORD=
# Leave empty on the VPS: compose points the app at its own Postgres (D9 open).
# Set only to use another database, as a libpq string or postgres:// URL.
CBL_DATABASE_URL=
# Set by compose on the VPS; leave empty.
CBL_DATABASE_HOST=
# 32 random bytes as 64 hex characters (openssl rand -hex 32). Encrypts tokens
# at rest. Back it up APART from the database dumps.
CBL_ENCRYPTION_KEY=

# ── service ─────────────────────────────────────────────────────────────────
# Set by compose on the VPS; leave empty.
CBL_HTTP_ADDR=
CBL_SIDECAR_URL=
# Defaults: 08:00-08:30 and mon-fri, in IST.
CBL_LOGIN_WINDOW=
CBL_LOGIN_DAYS=

# ── accounts ────────────────────────────────────────────────────────────────
# Comma-separated aliases, logged in one after another in this order. Each
# alias needs a DHAN_<ALIAS>_* block in upper case; copy the MAIN block.
CBL_ACCOUNTS=main
# The public callback registered with every account's Dhan API app.
DHAN_REDIRECT_URL=https://<subdomain>.beonedge.in/dhan/callback

DHAN_MAIN_CLIENT_ID=
DHAN_MAIN_API_KEY=
DHAN_MAIN_API_SECRET=
DHAN_MAIN_ACCOUNT_ID=
DHAN_MAIN_ACCOUNT_PIN=
# The base32 seed of this account's Dhan authenticator. Used only to log in.
DHAN_MAIN_TOTP_SECRET=

# ── token API ───────────────────────────────────────────────────────────────
# D3 is open: give each account its own seed (TOKEN_API_<ALIAS>_TOTP_SECRET),
# or one shared seed for every account without its own (TOKEN_API_TOTP_SECRET).
# A token API seed may never equal the account's Dhan seed; the service refuses.
TOKEN_API_MAIN_TOTP_SECRET=
TOKEN_API_TOTP_SECRET=
# D4 is open: true makes the API demand a Cloudflare Access service token too.
CBL_API_REQUIRE_ACCESS_JWT=
# Where the real client IP comes from. cloudflared sets cf-connecting-ip.
CBL_CLIENT_IP_HEADER=

# ── dashboard ───────────────────────────────────────────────────────────────
# Default true: the dashboard API needs the identity Cloudflare Access adds.
CBL_ADMIN_REQUIRE_ACCESS=
# D6 is open: comma-separated Google emails allowed in. Empty: anyone Access admits.
CBL_ADMIN_EMAILS=

# ── telegram ────────────────────────────────────────────────────────────────
# D8 is open: any bot and chat. Both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
