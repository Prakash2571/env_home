# Reference only. The real file lives at
#   /srv/dev_stack/CENTRALISED_BROKER_LOGIN/broker_login/.env
# and is placed by hand with mode 600. No release script reads, writes or
# removes it. Values are unquoted. Every key here is also in config/env.example;
# the export refuses to ship if the two disagree.

# ── storage ─────────────────────────────────────────────────────────────────
POSTGRES_DB=broker_login
POSTGRES_USER=broker_login
POSTGRES_PASSWORD=
# Leave empty on the VPS: compose points the app at its own Postgres (D9 open).
# Set only to use another database, as a libpq string or postgres:// URL.
CBL_DATABASE_URL=
# Set by compose on the VPS; leave empty.
CBL_DATABASE_HOST=
# 32 random bytes as 64 hex characters (openssl rand -hex 32). Encrypts the
# accounts and their tokens at rest. Back it up APART from the database dumps.
CBL_ENCRYPTION_KEY=

# ── service ─────────────────────────────────────────────────────────────────
# Set by compose on the VPS; leave empty.
CBL_HTTP_ADDR=
CBL_SIDECAR_URL=
# Defaults: 08:00-08:30 and mon-fri, in IST. Days take names, lists and ranges
# (mon,wed-fri), or everyday / daily / all for all seven.
CBL_LOGIN_WINDOW=
CBL_LOGIN_DAYS=

# ── accounts ────────────────────────────────────────────────────────────────
# Dhan accounts are added on the dashboard's Accounts page, sealed in the
# database under CBL_ENCRYPTION_KEY. None live in this file.
# The public callback registered with every account's Dhan API app.
DHAN_REDIRECT_URL=https://<subdomain>.beonedge.in/dhan/callback

# ── Cloudflare Access ───────────────────────────────────────────────────────
# The app verifies the JWT Cloudflare Access signs (Cf-Access-Jwt-Assertion);
# it never trusts the plain email header. The team domain is
# https://<team>.cloudflareaccess.com (Zero Trust → Settings → Custom Pages).
# Each AUD tag is on its Access application's Overview page.
CBL_ACCESS_TEAM_DOMAIN=
CBL_ACCESS_DASHBOARD_AUD=
CBL_ACCESS_API_AUD=

# ── token API ───────────────────────────────────────────────────────────────
# Each account's token API seed is generated on the Accounts page and shown once.
# D4 decided (A12): true on the VPS. The API then needs a Cloudflare Access
# service token (verified with CBL_ACCESS_API_AUD) as well as the TOTP.
CBL_API_REQUIRE_ACCESS_JWT=true
# Where the real client IP comes from. cloudflared sets cf-connecting-ip.
CBL_CLIENT_IP_HEADER=

# ── dashboard ───────────────────────────────────────────────────────────────
# Default true: the dashboard needs a verified Access sign-in
# (CBL_ACCESS_TEAM_DOMAIN and CBL_ACCESS_DASHBOARD_AUD). false only locally.
CBL_ADMIN_REQUIRE_ACCESS=
# D6 decided (A11): the dashboard email(s), comma-separated, repeating the Access
# policy as defence in depth. Empty: anyone Access admits.
CBL_ADMIN_EMAILS=

# ── telegram ────────────────────────────────────────────────────────────────
# D8 is open: any bot and chat. Both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
